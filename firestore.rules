rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid in [
          'VDVmEgrC8NgljqCokzhuhuZXkZM2',
          'Rs1Ko8wPJjOgm1rU6nAQD2mniuf1'
        ]
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(value, maxChars) {
      return value is string && value.size() > 0 && value.size() <= maxChars;
    }

    function isCommunityPostCreate() {
      return isSignedIn()
        && request.resource.data.authorUserId == request.auth.uid
        && isNonEmptyString(request.resource.data.authorName, 80)
        && request.resource.data.type in ['tip', 'question']
        && isNonEmptyString(request.resource.data.title, 160)
        && isNonEmptyString(request.resource.data.body, 4000)
        && request.resource.data.status == 'active'
        && request.resource.data.upvoteCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 8;
    }

    function isCommunityPostOwnerUpdate() {
      return isSignedIn()
        && resource.data.authorUserId == request.auth.uid
        && request.resource.data.authorUserId == resource.data.authorUserId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.upvoteCount == resource.data.upvoteCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.status in ['active', 'deleted']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'title', 'body', 'tags', 'status', 'updatedAt'
        ])
        && isNonEmptyString(request.resource.data.authorName, 80)
        && isNonEmptyString(request.resource.data.title, 160)
        && isNonEmptyString(request.resource.data.body, 4000)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 8;
    }

    function isCommunityCommentCreate() {
      return isSignedIn()
        && request.resource.data.authorUserId == request.auth.uid
        && isNonEmptyString(request.resource.data.authorName, 80)
        && isNonEmptyString(request.resource.data.body, 2000)
        && request.resource.data.postId is string;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /pagodas/{pagodaId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if false;
    }

    match /roadReports/{reportId} {
      allow read, write: if false;
    }

    match /communityPosts/{postId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create: if isCommunityPostCreate();
      allow delete: if (
        isSignedIn() &&
        resource.data.authorUserId == request.auth.uid
      ) || isAdmin();
      // Counters are updated by trusted Cloud Functions after comment/vote
      // document events. A signed-in client cannot forge popularity totals.
      allow update: if isAdmin() || isCommunityPostOwnerUpdate();

      match /comments/{commentId} {
        allow read: if get(
          /databases/$(database)/documents/communityPosts/$(postId)
        ).data.status == 'active' || isAdmin();
        allow create: if isCommunityCommentCreate() &&
          request.resource.data.postId == postId;
        allow update, delete: if (
          isSignedIn() &&
          resource.data.authorUserId == request.auth.uid
        ) || isAdmin();
      }

      match /votes/{voteId} {
        allow read: if isSignedIn() || isAdmin();
        allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          voteId == request.auth.uid;
        allow delete: if (
          isSignedIn() &&
          voteId == request.auth.uid
        ) || isAdmin();
        allow update: if isAdmin();
      }
    }

    // Collection-group queries over users/*/trips require an explicit trips match.
    match /{path=**}/trips/{tripId} {
      allow read: if isAdmin();
    }

    // The app reads vote state through a collection-group query over votes.
    match /{path=**}/votes/{voteId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        voteId == request.auth.uid;
      allow delete: if (
        isSignedIn() &&
        voteId == request.auth.uid
      ) || isAdmin();
      allow update: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
